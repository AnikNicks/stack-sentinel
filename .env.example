# Stack Sentinel — runtime env vars for live notification dispatch.
#
# These are target IDs only (which channel/project/space to post to), never secrets.
# Real credentials (Gmail app password, Slack bot token, Atlassian API tokens) are NOT env
# vars in this project — they live only in the Docker MCP Toolkit's OS-keychain secret store
# (`docker mcp secret set ...`) for the isolated `stack-sentinel` profile. See PROGRESS.md's
# "Live-readiness check" section for the exact setup commands.
#
# Copy this file to `.env` and fill in real values, or export these directly in your shell
# before running `scripts/simulate_production_run.py --live`. `.env` itself is gitignored —
# never commit it.

PULSE_EMAIL_ADDRESS=claudecodenotification@gmail.com
PULSE_SLACK_CHANNEL_ID=
PULSE_JIRA_PROJECT_KEY=
PULSE_CONFLUENCE_SPACE_KEY=
PULSE_DOCKER_MCP_PROFILE=stack-sentinel

# Optional — only read by dashboard/api's /ask endpoint, for the live console's "Ask Stack
# Sentinel" panel. This is the one place in the whole repo that calls a live third-party LLM
# (OpenAI, not Claude) — entirely separate from pulse/'s deterministic core and the six
# Claude subagents. Leave OPENAI_API_KEY unset and the console's built-in deterministic Q&A
# fallback keeps working exactly as before; nothing else in this repo depends on either
# variable.
OPENAI_API_KEY=
PULSE_OPENAI_MODEL=gpt-4o-mini
