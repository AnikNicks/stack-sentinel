        "error_rate_pct": {
          "target_max": 1.0
        },
        "p95_latency_ms": {
          "target_max": 1200
        },
        "uptime_pct": {
          "target_min": 99.9
        }
      },
      "agent_behavior_boundaries": [
        "Refunds over $200 must be routed to human approval before execution.",
        "Agent must never modify a customer's shipping address without a logged confirmation step."
      ],
      "key_risks_at_launch": [
        "Resolution agent over-trusting ambiguous refund requests",
        "Prompt-injection via customer-submitted ticket text",
        "Shipping-address changes enabling account-takeover fraud"
      ]
    }
